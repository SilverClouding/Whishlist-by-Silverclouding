{% assign product_for_wishlist = block.settings.product | default: product %}
{% assign btn_color = block.settings.button_color | default: '#1a1a1a' %}
{% assign btn_active_color = block.settings.active_color | default: '#1a1a1a' %}
{% assign icon_color = block.settings.icon_color | default: '#1a1a1a' %}
{% assign show_label = block.settings.show_label %}
{% assign default_label_add = 'wishlist.add_to_wishlist' | t %}
{% assign default_label_saved = 'wishlist.saved' | t %}
{% assign label_add = block.settings.label_add | default: default_label_add %}
{% assign label_saved = block.settings.label_saved | default: default_label_saved %}
{% assign custom_svg = block.settings.custom_svg %}

<div
  data-silv-wishlist
  data-product-id="{{ product_for_wishlist.id }}"
  data-product-handle="{{ product_for_wishlist.handle }}"
  data-product-title="{{ product_for_wishlist.title | escape }}"
  data-product-image="{{ product_for_wishlist.featured_image | image_url: width: 600 | escape }}"
  data-product-price="{{ product_for_wishlist.price | money | escape }}"
  data-product-variant-id="{{ product_for_wishlist.selected_or_first_available_variant.id }}"
  data-label-add="{{ label_add | escape }}"
  data-label-saved="{{ label_saved | escape }}"
  style="
    --silv-btn-color: {{ btn_color }};
    --silv-btn-active-color: {{ btn_active_color }};
    --silv-icon-color: {{ icon_color }};
  "
>
  <button
    type="button"
    class="silv-wishlist button"
    data-silv-wishlist-button
    aria-label="{{ label_add | escape }}"
  >
    {% if custom_svg != blank %}
      <span class="silv-wishlist__icon silv-wishlist__icon--default" aria-hidden="true">
        {{ custom_svg }}
      </span>
      <span class="silv-wishlist__icon silv-wishlist__icon--active" aria-hidden="true" style="display:none">
        {{ custom_svg }}
      </span>
    {% else %}
      <span class="silv-wishlist__icon silv-wishlist__icon--default" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>

      <span class="silv-wishlist__icon silv-wishlist__icon--active" aria-hidden="true" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </span>
    {% endif %}

    {% if show_label %}
      <span class="silv-wishlist__label" data-silv-wishlist-label>{{ label_add | escape }}</span>
    {% endif %}
  </button>
</div>

<script>
(() => {
  const script = document.currentScript;

  const whenEmbedReady = (fn) => {
    if (window.silvercloudingEmbedEnabled) fn();
    else document.addEventListener('silverclouding:embed-ready', fn, { once: true });
  };

  whenEmbedReady(() => {
    const storageKey = 'silverclouding_wishlist';
    const visitorStorageKey = 'silverclouding_wishlist_visitor';
    const syncEndpoint = '/apps/silverclouding-wishlist';

    const container = script?.previousElementSibling;
    if (!container?.hasAttribute('data-silv-wishlist')) return;

    const button = container.querySelector('[data-silv-wishlist-button]');
    const labelEl = container.querySelector('[data-silv-wishlist-label]');
    if (!button) return;

    const productId = container.dataset.productId;
    const productHandle = container.dataset.productHandle;
    const productTitle = container.dataset.productTitle;
    const productImage = container.dataset.productImage;
    const productPrice = container.dataset.productPrice;
    const productScope = button.closest('product-info, .shopify-section') || document;
    const getVariantInput = () => productScope.querySelector('form[action*="/cart/add"] [name="id"]') || productScope.querySelector('[name="id"]');
    const getVariantId = () => String(getVariantInput()?.value || container.dataset.productVariantId || '').trim();
    const itemKey = (item) => `${String(item.id)}::${String(item.variantId || '')}`;
    const currentLocale = {{ request.locale.iso_code | downcase | json }};
    let labelAdd = container.dataset.labelAdd || {{ 'wishlist.add_to_wishlist' | t | json }};
    let labelSaved = container.dataset.labelSaved || {{ 'wishlist.saved' | t | json }};
    let toastAdded = {{ 'wishlist.added_to_wishlist' | t | json }};
    let toastRemoved = {{ 'wishlist.removed_from_wishlist' | t | json }};

    const applyDynamicLabels = (appSettings) => {
      if (!appSettings?.translations) return;
      try {
        const trans = typeof appSettings.translations === 'string'
          ? JSON.parse(appSettings.translations)
          : appSettings.translations;
        const loc = trans[currentLocale] || trans[currentLocale.split('-')[0]] || {};
        if (loc.add_to_wishlist) labelAdd = loc.add_to_wishlist;
        if (loc.saved) labelSaved = loc.saved;
        if (loc.added_to_wishlist) toastAdded = loc.added_to_wishlist;
        if (loc.removed_from_wishlist) toastRemoved = loc.removed_from_wishlist;
        refresh();
      } catch {}
    };

    if (window.silvercloudingSettings) {
      applyDynamicLabels(window.silvercloudingSettings);
    }
    document.addEventListener('silverclouding:settings-loaded', (e) => {
      applyDynamicLabels(e.detail);
    });

    let requestInFlight = false;
    let customerAuthenticated = false;

    const getWishlist = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    };

    const saveWishlist = (items) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(items));
        window.dispatchEvent(new CustomEvent('silverclouding:wishlist-updated'));
      } catch {}
    };

    const updateView = (isSaved) => {
      button.classList.toggle('is-active', isSaved);
      button.setAttribute('aria-label', isSaved ? labelSaved : labelAdd);
      if (labelEl) labelEl.textContent = isSaved ? labelSaved : labelAdd;
    };

    const refresh = () => {
      const variantId = getVariantId();
      const saved = getWishlist().some(item => itemKey(item) === itemKey({ id: productId, variantId }));
      updateView(saved);
    };

    const getVisitorId = () => {
      let id = localStorage.getItem(visitorStorageKey);

      if (!id) {
        id = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 14)}`;
        localStorage.setItem(visitorStorageKey, id);
      }

      return id;
    };

    const persistLocalFallback = (operation, item) => {
      const items = getWishlist();
      const index = items.findIndex(
        saved => itemKey(saved) === itemKey({ id: item.productId, variantId: item.variantId })
      );

      if (operation === 'add' && index < 0) {
        items.push({
          id: item.productId,
          variantId: item.variantId || '',
          variantTitle: item.variantTitle || '',
          handle: item.productHandle,
          title: item.productTitle,
          image: item.productImage || '',
          price: item.productPrice || '',
          addedAt: new Date().toISOString()
        });
      }

      if (operation === 'remove' && index >= 0) {
        items.splice(index, 1);
      }

      saveWishlist(items);

      window.silvercloudingWishlistToast?.({
        message: operation === 'add' ? toastAdded : toastRemoved,
        image: item.productImage || '',
        title: item.productTitle || ''
      });

      return items;
    };

    const trackGuest = async (operation, item) => {
      try {
        const res = await fetch(syncEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            operation,
            visitorId: getVisitorId(),
            ...item
          })
        });

        const data = await res.json().catch(() => ({}));
        if (res.status === 429 || data?.limitReached || data?.error?.toLowerCase().includes('limit')) {
          window.silvercloudingLimitReached = true;
          return { blocked: true };
        }

        if (res.ok && data?.tracked) return data;
      } catch {}

      return { blocked: true };
    };

    const sync = async (operation, item) => {
      if (operation === 'add' && window.silvercloudingLimitReached) {
        return false;
      }

      if (!customerAuthenticated) {
        const trackResult = await trackGuest(operation, item);
        if (operation === 'add' && (!trackResult || trackResult.blocked || !trackResult.tracked)) {
          return false;
        }
        return persistLocalFallback(operation, item);
      }

      const res = await fetch(syncEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          operation,
          visitorId: getVisitorId(),
          ...item
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 429 || data?.limitReached || data?.error?.toLowerCase().includes('limit')) {
        window.silvercloudingLimitReached = true;
        if (operation === 'remove' || operation === 'clear') {
          window.silvercloudingWishlistToast?.({ message: toastRemoved });
          return getWishlist();
        }

        return false;
      }

      if (!res.ok) {
        customerAuthenticated = false;
        return persistLocalFallback(operation, item);
      }

      const data = await res.json();

      if (!Array.isArray(data.items)) {
        customerAuthenticated = false;
        return persistLocalFallback(operation, item);
      }

      const synced = data.items.map(item => ({
        id: item.productId,
        variantId: item.variantId || '',
        variantTitle: item.variantTitle || '',
        handle: item.productHandle,
        title: item.productTitle,
        image: item.productImage || '',
        price: item.productPrice || '',
        addedAt: item.createdAt
      }));

      saveWishlist(synced);

      window.silvercloudingWishlistToast?.({
        message: operation === 'add' ? toastAdded : toastRemoved,
        image: item.productImage || '',
        title: item.productTitle || ''
      });

      return synced;
    };

    const syncExistingItems = async () => {
      if (window.silvercloudingWishlistSyncPromise) {
        return window.silvercloudingWishlistSyncPromise;
      }

      const run = (async () => {
        const res = await fetch(syncEndpoint, {
          credentials: 'same-origin'
        });

        if (!res.ok) return;

        const data = await res.json();
        customerAuthenticated = data.authenticated === true;

        if (!data.authenticated || !Array.isArray(data.items)) return;

        let synced = data.items.map(item => ({
          id: item.productId,
          variantId: item.variantId || '',
          variantTitle: item.variantTitle || '',
          handle: item.productHandle,
          title: item.productTitle,
          image: item.productImage || '',
          price: item.productPrice || '',
          addedAt: item.createdAt
        }));

        for (const item of getWishlist()) {
          if (!synced.some(saved => itemKey(saved) === itemKey(item))) {
            const merged = await sync('add', {
              productId: item.id,
              variantId: item.variantId || '',
              variantTitle: item.variantTitle || '',
              productHandle: item.handle,
              productTitle: item.title,
              productImage: item.image,
              productPrice: item.price
            });

            if (merged) synced = merged;
          }
        }

        saveWishlist(synced);
        refresh();
      })();

      window.silvercloudingWishlistSyncPromise = run.finally(() => {
        window.silvercloudingWishlistSyncPromise = null;
      });

      return window.silvercloudingWishlistSyncPromise;
    };

    refresh();

    const initialSync = syncExistingItems().catch(() => {});

    window.addEventListener('silverclouding:wishlist-updated', refresh);

    window.addEventListener('storage', (e) => {
      if (e.key === storageKey) refresh();
    });
    productScope.addEventListener('change', refresh);
    productScope.addEventListener('input', refresh);
    productScope.addEventListener('variant:change', refresh);

    button.addEventListener('click', async () => {
      if (requestInFlight) return;

      requestInFlight = true;
      button.disabled = true;

      try {
        await initialSync;

        const variantId = getVariantId();
        const variantData = { id: productId, variantId };
        const saved = getWishlist().some(item => itemKey(item) === itemKey(variantData));

        const result = await sync(saved ? 'remove' : 'add', {
          productId,
          variantId,
          productHandle,
          productTitle,
          productImage,
          productPrice
        });

        if (result !== false && result !== null) updateView(!saved);
      } catch (error) {
        console.error('Wishlist request failed', error);
        window.silvercloudingWishlistToast?.({ message: {{ 'wishlist.temporarily_unavailable' | t | json }} });
      } finally {
        button.disabled = false;
        requestInFlight = false;
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Page Button",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "header",
      "content": "Button appearance"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show text label",
      "default": true
    },
    {
      "type": "text",
      "id": "label_add",
      "label": "Label — not saved",
      "default": "Add to wishlist"
    },
    {
      "type": "text",
      "id": "label_saved",
      "label": "Label — saved",
      "default": "Saved"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button border & text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Button color when saved",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Custom icon (optional)"
    },
    {
      "type": "html",
      "id": "custom_svg",
      "label": "Custom SVG icon",
      "info": "Paste your SVG markup here. Leave empty to use the default heart icon."
    }
  ]
}
{% endschema %}